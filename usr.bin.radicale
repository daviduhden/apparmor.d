# Radicale CalDAV/CardDAV server profile
# Purpose: confine the radicale daemon in enforce mode while allowing
# access to TLS certificates, runtime data, and necessary Python runtime
# files. Blocks a small set of known build-tool paths as defense in depth;
# this is not a complete compiler/linker restriction.
#
# See the LICENSE file at the top of the project tree for copyright
# and license details.

# ABI and global tunables
abi <abi/4.0>,
include <tunables/global>

# Profile definition
# Main profile for the `radicale` executable. Flags: attach_disconnected
# (handle paths no longer connected to the filesystem), enforce (enforce
# mode), mediate_deleted (mediate access to deleted files).
profile radicale /{usr/,}bin/radicale flags=(attach_disconnected, enforce, mediate_deleted) {

  # Standard abstractions
  # Reuse common AppArmor abstractions to avoid duplicating rules.
  include <abstractions/base>
  include <abstractions/nameservice>
  include <abstractions/python>
  include <abstractions/ssl_certs>
  include <abstractions/user-tmp>

  # Capabilities & network
  # Minimal capabilities required by the daemon at runtime.
  capability chown,
  capability dac_override,
  capability setgid,
  capability setuid,

  # Network access: allow IPv4 and IPv6 stream sockets.
  network inet stream,
  network inet6 stream,

  # Basic device and proc access
  /dev/null rwk,
  /proc/** r,

  # TLS certificates and SSL configuration
  # Read access to system TLS certificates and openssl configuration.
  /etc/letsencrypt/live/** r,
  /etc/ssl/certs/** r,
  /etc/ssl/openssl.cnf r,
  /etc/ssl/private/** r,

  # Radicale configuration and rights files
  # Allow reading Radicale configuration and rights/user files.
  /etc/radicale/** r,
  /etc/radicale/rights r,
  /etc/radicale/users r,

  # Runtime data, cache and logs
  # Runtime collections (read/write), optional file cache and log files.
  /var/lib/radicale/ r,
  /var/lib/radicale/collections/ rw,
  /var/lib/radicale/collections/** rwk,
  /var/cache/radicale/ rw,
  /var/cache/radicale/** rwk,
  /var/log/radicale/ rw,
  /var/log/radicale/** rw,

  # Sockets and runtime state
  /{,var/}run/radicale.sock rw,
  /{,var/}run/radicale/** rw,

  # Executables and interpreter access
  # The profile is attached to /usr/bin/radicale, a Python script, so the
  # interpreter must be executable. pix transitions to a dedicated python
  # profile when one exists and otherwise keeps this profile (ix fallback);
  # the lowercase form scrubs the environment. Python module/cache paths are
  # already covered by abstractions/python, so no broad extra rules are needed.
  /{usr/,}bin/python3 pix,
  /{usr/,}bin/radicale mrpx,

  # Defense in depth: block this host's known compiler/linker paths. AppArmor
  # is already default-deny for execution, and this list is specific to one
  # architecture/toolchain; it is not a complete build-tool block.
  deny /usr/bin/aarch64-linux-gnu-gcc-14 x,
  deny /usr/bin/aarch64-linux-gnu-ld.bfd x,
  deny /usr/libexec/gcc/aarch64-linux-gnu/14/collect2 x,
  deny /usr/libexec/gcc/aarch64-linux-gnu/14/liblto_plugin.so x,
  deny /usr/sbin/ldconfig x,

  # Local overrides
  include if exists <local/usr.bin.radicale>

}

